---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import '../styles/sections.css';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en" data-finish="black">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#ff4499">
  <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin>
  <script is:inline>
    try {
      var f = localStorage.getItem('heavy-metal-finish');
      if (f === 'white') f = 'silver'; // white and silver are now one finish
      if (['silver', 'black', 'gold', 'burgundy'].indexOf(f) > -1) document.documentElement.dataset.finish = f;
    } catch (e) {}
    document.documentElement.classList.add('js');
  </script>
  <script is:inline>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body>
  <slot />
</body>
</html>
